---
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';
import Lightbox from '../components/Lightbox.astro';

const base = import.meta.env.BASE_URL;

const images = [
  { src: `${base}/images/motorsport/SLA00905.jpg`, alt: '' },
  { src: `${base}/images/motorsport/4d19f3_ea1ee0fe85a9474996093ef71d7661f5~mv2_d_3605_2403_s_4_2.webp`, alt: '' },
  { src: `${base}/images/motorsport/SLA00910.jpg`, alt: '' },
  { src: `${base}/images/motorsport/SLA04645.jpg`, alt: '' },
  { src: `${base}/images/motorsport/SLB02774.jpg`, alt: '' },
  { src: `${base}/images/motorsport/SLB07609.jpg`, alt: '' },
  { src: `${base}/images/motorsport/ZIC Circuit Hero 1 2019.jpg`, alt: 'ZIC Circuit Hero 1 2019' },
];
---

<Layout title="Motorsport">
  <div class="max-w-7xl mx-auto px-6 pt-10 pb-4">
    <h1 class="text-xs tracking-[0.4em] uppercase text-white/30">Motorsport</h1>
  </div>
  <Gallery images={images} title="Motorsport" />
  <Lightbox />
</Layout>
