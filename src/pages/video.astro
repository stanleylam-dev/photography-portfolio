---
import Layout from '../layouts/Layout.astro';

/**
 * To add more videos, paste the YouTube share URL (youtu.be/...) and extract the ID after the slash.
 * Format: { embedUrl: 'https://www.youtube.com/embed/VIDEO_ID', title: 'Your title' }
 */
const videos = [
  {embedUrl: 'https://www.youtube.com/embed/_zvOV1Chv_M', title: 'Sammi & Ivan Wedding Concept Video' },
  {embedUrl: 'https://youtube.com/embed/9VOe_CN0F-4', title: 'Red Bull HK Half Court'},
  {embedUrl: 'https://youtube.com/embed/o854OX2X2a0?feature=share', title: 'FPV Drone Showcase'},
  {embedUrl: 'https://youtube.com/embed/lsybcr_4Sbk?si=ZrqlsC-YtI9wN6XV', title: 'Sportsoho'},
  {embedUrl: 'https://youtube.com/embed/M6fmebq7Clc', title: 'HKJC - Watersports 4 all'},
  {embedUrl: 'https://youtube.com/embed/emWHDlVRr9c', title: 'Red Bull HK Half Court Promotion'},
  {embedUrl: 'https://www.youtube.com/embed/pVyM9L0TPak?si=RULy_Arnp8gwSO8n', title: 'Tithe Ethical Consumption Movement' },
];
---

<Layout title="Video">
  <div class="max-w-7xl mx-auto px-6 pt-10 pb-4">
    <h1 class="text-xs tracking-[0.4em] uppercase text-white/30">Video</h1>
  </div>

  {videos.length === 0 ? (
    <div class="max-w-7xl mx-auto px-6 py-32 text-center">
      <p class="text-white/30 text-sm tracking-widest uppercase">No videos yet</p>
      <p class="text-white/20 text-xs mt-2">Add your video embed URLs to <code class="font-mono">src/pages/video.astro</code></p>
    </div>
  ) : (
    <div class="max-w-7xl mx-auto px-4 pb-16">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {videos.map((video) => (
          <div class="relative aspect-video bg-zinc-900">
            <iframe
              src={video.embedUrl}
              title={video.title}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              class="absolute inset-0 w-full h-full"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>
  )}
</Layout>
